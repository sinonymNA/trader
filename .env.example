# OANDA Practice Account
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_BASE_URL=https://api-fxpractice.oanda.com

# Safety (safe defaults — change with care)
TRADING_ENABLED=false
DRY_RUN=true

# App
LOG_LEVEL=INFO
TIMEZONE=America/New_York
DATABASE_URL=sqlite+aiosqlite:///./trader.db

# Instruments & timing
INSTRUMENTS=EUR_USD,GBP_USD,USD_JPY
WORKER_INTERVAL_SECONDS=15

# Risk
STOP_LOSS_PIPS=20
TAKE_PROFIT_PIPS=40
MAX_POSITION_UNITS=1000
DAILY_LOSS_LIMIT_USD=50.0
MAX_OPEN_TRADES=1
MAX_TRADES_PER_DAY=3
MAX_LOSSES_PER_DAY=2

# Strategy (MA-crossover + breakout)
SHORT_MA_PERIOD=10
LONG_MA_PERIOD=30
BREAKOUT_LOOKBACK=20
CANDLE_COUNT=60
TRADE_UNITS=100

# Apex simulator (funded-challenge rules — disabled by default)
APEX_ENABLED=false
APEX_ACCOUNT_SIZE=100000.0
APEX_MAX_DAILY_LOSS_PCT=0.02
APEX_TRAILING_DRAWDOWN_PCT=0.04
APEX_PROFIT_TARGET_PCT=0.08
